<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_form_hr_attendance_ctrl" model="ir.ui.view">
    <field name="name">hr.attendance.location.form</field>
    <field name="model">hr.attendance</field>
    <field name="inherit_id" ref="hr_attendance.hr_attendance_view_form"/>
    <field name="arch" type="xml">
      <xpath expr="//sheet/group" position="inside">
        <group string="Office Locations">
          <field name="checkin_office_location_id" readonly="1"/>
          <field name="checkout_office_location_id" readonly="1"/>
        </group>
      </xpath>
    </field>
  </record>

  <record id="view_list_hr_attendance_ctrl" model="ir.ui.view">
    <field name="name">hr.attendance.location.list</field>
    <field name="model">hr.attendance</field>
    <field name="inherit_id" ref="hr_attendance.view_attendance_tree"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='overtime_hours']" position="replace">
	    	<field name="overtime_hours" invisible="1" optional="hide"/>
      </xpath>
      <xpath expr="//field[@name='validated_overtime_hours']" position="replace">
	    	<field name="validated_overtime_hours" invisible="1" optional="hide"/>
      </xpath>
      <xpath expr="//field[@name='worked_hours']" position="before">
        <field name="in_country_name" string="Check In Location" readonly="1"/>
        <field name="out_country_name" string="Check Out Location" readonly="1"/>
      </xpath>
    </field>
  </record>

  <record id="hr_attendance.hr_attendance_action" model="ir.actions.act_window">
    <field name="name">Attendances</field>
    <field name="path">attendances</field>
    <field name="res_model">hr.attendance</field>
    <field name="view_mode">list,form</field>
    <field name="context">{}</field>
    <field name="search_view_id" ref="hr_attendance.hr_attendance_view_filter"/>
    <field name="help">
    </field>
  </record>
</odoo>