<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_employee_form_dahua" model="ir.ui.view">
        <field name="name">hr.employee.form.dahua.attendance</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='barcode']/.." position="after">
                <field name="dahua_user_id" groups="hr_attendance.group_hr_attendance_manager"/>
            </xpath>
        </field>
    </record>

    <menuitem id="menu_dahua_root" name="Dahua Attendance" parent="base.menu_custom" sequence="51" groups="base.group_system"/>

    <record id="view_dahua_device_list" model="ir.ui.view">
        <field name="name">dahua.device.config.list</field>
        <field name="model">dahua.device.config</field>
        <field name="arch" type="xml">
            <list><field name="name"/><field name="ip"/><field name="username"/><field name="verify_ssl"/><field name="active"/></list>
        </field>
    </record>
    <record id="view_dahua_device_form" model="ir.ui.view">
        <field name="name">dahua.device.config.form</field>
        <field name="model">dahua.device.config</field>
        <field name="arch" type="xml">
            <form string="Dahua Device">
                <header><button name="action_test_device" type="object" string="Test Connection" class="btn-primary"/></header>
                <sheet><group><field name="name"/><field name="ip" placeholder="https://192.0.2.10"/><field name="username"/><field name="password" password="True"/><field name="verify_ssl"/><field name="active"/></group></sheet>
            </form>
        </field>
    </record>
    <record id="action_dahua_device" model="ir.actions.act_window">
        <field name="name">Devices</field><field name="res_model">dahua.device.config</field><field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_dahua_device" name="Devices" parent="menu_dahua_root" action="action_dahua_device" sequence="10"/>

    <record id="view_dahua_schedule_list" model="ir.ui.view">
        <field name="name">dahua.schedule.config.list</field><field name="model">dahua.schedule.config</field>
        <field name="arch" type="xml"><list><field name="name"/><field name="mode"/><field name="days"/><field name="timezone"/></list></field>
    </record>
    <record id="view_dahua_schedule_form" model="ir.ui.view">
        <field name="name">dahua.schedule.config.form</field><field name="model">dahua.schedule.config</field>
        <field name="arch" type="xml"><form><sheet><group><field name="name"/><field name="mode"/><field name="days" invisible="mode != 'auto'"/><field name="start_time" invisible="mode != 'manual'"/><field name="end_time" invisible="mode != 'manual'"/><field name="timezone"/></group></sheet></form></field>
    </record>
    <record id="action_dahua_schedule" model="ir.actions.act_window">
        <field name="name">Import Settings</field><field name="res_model">dahua.schedule.config</field><field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_dahua_schedule" name="Import Settings" parent="menu_dahua_root" action="action_dahua_schedule" sequence="20"/>

    <record id="view_dahua_log_list" model="ir.ui.view">
        <field name="name">dahua.attendance.log.list</field><field name="model">dahua.attendance.log</field>
        <field name="arch" type="xml"><list create="false" edit="false"><field name="event_datetime"/><field name="device_id"/><field name="user_id"/><field name="card_name"/><field name="synced"/></list></field>
    </record>
    <record id="action_dahua_log" model="ir.actions.act_window">
        <field name="name">Imported Logs</field><field name="res_model">dahua.attendance.log</field><field name="view_mode">list,form</field><field name="context">{'create': False}</field>
    </record>
    <menuitem id="menu_dahua_log" name="Imported Logs" parent="menu_dahua_root" action="action_dahua_log" sequence="30"/>

    <record id="view_dahua_policy_list" model="ir.ui.view">
        <field name="name">dahua.attendance.policy.list</field><field name="model">dahua.attendance.policy</field>
        <field name="arch" type="xml"><list><field name="employee_id"/><field name="dahua_user_id"/><field name="active"/></list></field>
    </record>
    <record id="view_dahua_policy_form" model="ir.ui.view">
        <field name="name">dahua.attendance.policy.form</field><field name="model">dahua.attendance.policy</field>
        <field name="arch" type="xml"><form><sheet><group><field name="employee_id"/><field name="dahua_user_id" readonly="1"/><field name="active"/></group></sheet></form></field>
    </record>
    <record id="action_dahua_policy" model="ir.actions.act_window">
        <field name="name">Excluded Employees</field><field name="res_model">dahua.attendance.policy</field><field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_dahua_policy" name="Excluded Employees" parent="menu_dahua_root" action="action_dahua_policy" sequence="40"/>
</odoo>
