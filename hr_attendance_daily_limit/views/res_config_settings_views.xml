<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_daily_limit" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.attendance.daily.limit</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr_attendance.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='hr_attendance']//block[@name='kiosk_mode_setting_container']" position="inside">
                <setting id="hr_attendance_daily_limit_setting"
                         string="Attendance Protection (1 per day)"
                         help="If enabled, employees can only check-in/out once per day (prevents multiple attendances).">
                    <field name="hr_attendance_daily_limit_enabled"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>